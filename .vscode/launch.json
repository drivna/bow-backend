{
	"version": "0.2.0",
	"configurations": [
		{
			"name": "Python Debugger: Flask",
			"type": "debugpy",
			"request": "launch",
			"module": "flask",
			"env": {
				"FLASK_APP": "run.py",
				"FLASK_DEBUG": "1"
			},
			"args": [
				"run",
				"--no-debugger",
				"--no-reload",
				"--port=5001" // Change to your desired port
			],
			"jinja": true,
			"autoStartBrowser": false
		}
	]
}
